.archive/
*.bak
*.tmp

# Archivos Excel dinámicos (se preservan las plantillas oficiales de test_files)
*.xlsx
!test_files/*.xlsx

# Metadatos de sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Ignorar carpeta completa de pruebas y plantillas locales
test_files/